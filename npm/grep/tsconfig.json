{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["es2021"],   
    "module": "commonjs",
    "moduleResolution": "node",    
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "types": ["node"],
  "include": [
    "src/**/*",
    "cypress/**/*",
    "expects/**/*",
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
} 
