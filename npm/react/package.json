{
  "name": "@cypress/react",
  "version": "0.0.0-development",
  "description": "Test React components using Cypress",
  "keywords": [
    "cypress",
    "react",
    "component-testing",
    "react-testing",
    "testing",
    "react-component",
    "jsx"
  ],
  "homepage": "https://github.com/cypress-io/cypress/blob/develop/npm/react/#readme",
  "bugs": "https://github.com/cypress-io/cypress/issues/new?assignees=&labels=npm%3A%20%40cypress%2Freact&template=1-bug-report.md&title=",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cypress-io/cypress.git"
  },
  "license": "MIT",
  "main": "dist/cypress-react.cjs.js",
  "unpkg": "dist/cypress-react.browser.js",
  "module": "dist/cypress-react.esm-bundler.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c rollup.config.mjs",
    "postbuild": "node ../../scripts/sync-exported-npm-with-cli.js",
    "check-ts": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json && tsc --noEmit -p tsconfig.cypress.json",
    "cy:open": "node ../../scripts/cypress.js open --component",
    "cy:open:debug": "node --inspect-brk ../../scripts/start.js --component-testing --run-project ${PWD}",
    "cy:run": "node ../../scripts/cypress.js run --component",
    "cy:run:debug": "node --inspect-brk ../../scripts/start.js --component-testing --run-project ${PWD}",
    "lint": "eslint",
    "test": "yarn cy:run",
    "watch": "yarn build --watch --watch.exclude ./dist/**/*"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json}": "eslint --fix"
  },
  "devDependencies": {
    "@cypress/mount-utils": "0.0.0-development",
    "@packages/eslint-config": "0.0.0-development",
    "@testing-library/cypress": "10.1.3",
    "@vitejs/plugin-react": "4.6.0",
    "axios": "^1.20.0",
    "cypress": "0.0.0-development",
    "eslint": "^9.31.0",
    "jiti": "^2.4.2",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.28.0",
    "react-router-dom": "6.28.0",
    "rollup": "^4.60.2",
    "typescript": "~5.4.5",
    "vite": "^8.0.9"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "cypress": "*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/cli/react",
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "standard": {
    "globals": [
      "Cypress",
      "cy",
      "expect"
    ]
  }
}
