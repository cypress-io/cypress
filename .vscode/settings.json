{
  "eslint.alwaysShowStatus": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json"
  ],
  "eslint.enable": true,
  // each workspace has its own eslint.config.ts and eslint install; the
  // extension loads the ESLint library from the working directory, so run it
  // from the nearest package.json
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  // this project does not use Prettier
  // thus set all settings to disable accidentally running Prettier
  "prettier.requireConfig": true,
  "prettier.disableLanguages": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",

  // Volar is the main extension that powers Vue's language features.
  // These are commented out because they slow down node development
  // "volar.autoCompleteRefs": false,
  "volar.takeOverMode.enabled": "auto",

  "editor.tabSize": 2,
}
