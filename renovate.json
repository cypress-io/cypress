{
  "configMigration": true,
  "dependencyDashboard": {
    "enabled": true
  },
  "extends": [
    ":semanticCommits",
    "group:monorepos",
    "group:recommended",
    "helpers:pinGitHubActionDigests",
    "replacements:all",
    "workarounds:all"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the pinned cypress-io/release-automations checkout ref updated to the latest master commit",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository: 'cypress-io/release-automations'\\s+ref: '(?<currentDigest>[0-9a-f]+)' # (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "cypress-io/release-automations",
      "packageNameTemplate": "https://github.com/cypress-io/release-automations",
      "datasourceTemplate": "git-refs"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/system-tests/projects/**"
  ],
  "internalChecksFilter": "strict",
  "labels": [
    "type: dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitScope": "deps",
      "semanticCommitType": "chore"
    },
    {
      "description": "Runtime dependencies of the CLI, the binary and the published npm packages reach users",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchFileNames": [
        "cli/**",
        "npm/**",
        "packages/**"
      ],
      "semanticCommitScope": null,
      "semanticCommitType": "dependency"
    },
    {
      "automerge": true,
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    },
    {
      "description": "Peer ranges are the versions users may install; bumping them drops support for older versions",
      "matchDepTypes": [
        "peerDependencies"
      ],
      "enabled": false
    },
    {
      "description": "The base-internal tag without a suffix pins the minimum supported Node.js version",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "cypress/base-internal"
      ],
      "matchCurrentValue": "/^\\d+\\.\\d+\\.\\d+$/",
      "enabled": false
    }
  ],
  "postUpdateOptions": [
    "yarnDedupeHighest"
  ],
  "prConcurrentLimit": 4,
  "prHourlyLimit": 1,
  "rangeStrategy": "bump",
  "separateMultipleMajor": true,
  "timezone": "America/New_York",
  "vulnerabilityAlerts": {
    "enabled": false,
    "minimumReleaseAge": null
  }
}
