// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`lib/tap error rendering catalogue > AMBIGUOUS_COMMAND 1`] = `
"> cypress tap command --test-id r7 --command-id 1
That command id matches more than one row of the test.

"1" matches:

  h2:1 (before each)
  h3:1 (before each)
  h5:1 (after each)

Qualify the id with the section it belongs to, as cypress tap reporter lists it."
`;

exports[`lib/tap error rendering catalogue > ATTEMPT_NOT_FOUND 1`] = `
"> cypress tap reporter --test-id r7 --attempt 5
No attempt of this test matched that number.

Looked for --attempt 5. Test "r7" has 3 attempts.

--attempt takes a 1-based attempt number and selects an earlier attempt of a retried test; omit it for the latest."
`;

exports[`lib/tap error rendering catalogue > BINDING_NOT_FOUND 1`] = `
"> cypress tap status
Could not make a connection to the Cypress session.

The Cypress session may still be loading, so try again in a moment. If the problem persists, the tab running Cypress may have been closed; open a browser in Cypress and try again."
`;

exports[`lib/tap error rendering catalogue > BINDING_THREW 1`] = `
"> cypress tap reporter
The Cypress session failed while running the command.

Check the Cypress session with cypress tap status, then try again.

If the problem persists, search for an existing issue or open a GitHub issue at

  https://github.com/cypress-io/cypress/issues"
`;

exports[`lib/tap error rendering catalogue > CDP_UNREACHABLE 1`] = `
