{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.tsx",
    "cypress/**/*.tsx",
    "*.d.ts",
    "cypress/support/**/*.ts"
  ],
  "exclude": [
    "**/*.vue.tsx",
    "**/*.vue.cy.tsx",
    "**/*.vue.spec.tsx"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
