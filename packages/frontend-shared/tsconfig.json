{
  "extends": "../ts/tsconfig.json",
  // React `.tsx` files are checked by tsconfig.react.json
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.vue.tsx",
    "src/**/*.vue.*.tsx",
    "cypress/**/*.ts",
    "cypress/**/*.vue.tsx",
    "cypress/**/*.vue.*.tsx",
    "*.d.ts"
  ],
  "exclude": [
    "vue-sfc.react.d.ts"
  ],
  "compilerOptions": {
    "module": "esnext",
    "lib": ["dom", "ESNext"],
    "jsx": "preserve",
    // Vue 3.4+ doesn't register a global JSX namespace, so Vue JSX reads its
    // types from vue/jsx-runtime
    "jsxImportSource": "vue",
    "preserveWatchOutput": true,
    "noImplicitThis": false,
    "noErrorTruncation": true,
    "paths": {
      "@cy/components/*": ["../frontend-shared/src/components/*"]
    },
    "types": [
      "chrome",
      "@intlify/unplugin-vue-i18n/messages",
      "@testing-library/cypress",
      "cypress-real-events", 
      "cypress"
    ],
  }
}
