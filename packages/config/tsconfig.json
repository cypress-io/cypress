{
  "include": [
    "src/*.ts"
  ],
  "exclude": [
    "test"
  ],
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "allowJs": false,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,       
    "esModuleInterop": true,
    "resolveJsonModule": true,     
    "declaration": true,                     /* Skip type checking all .d.ts files. */
    "types": ["mocha", "node"],
    "typeRoots": [
      "../../node_modules/@types"
    ],
  }
}
