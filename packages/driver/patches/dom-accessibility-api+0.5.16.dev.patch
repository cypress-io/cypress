+  // Cypress patch, accname 1.2 step 2A: a hidden node is skipped unless it is
+  // part of an aria-labelledby or aria-describedby traversal whose directly
+  // referenced node is hidden. Each referenced node starts its own traversal,
+  // so a nested reference to a visible node skips its hidden descendants again.
+  // https://w3c.github.io/accname/#step2A
+  var inHiddenReferencedTraversal = false;
   function computeTextAlternative(current, context) {
+    if (!context.isReferenced) {
+      return computeTextAlternativeStep(current, context);
+    }
+    var outerTraversal = inHiddenReferencedTraversal;
+    inHiddenReferencedTraversal = !hidden && isHidden(current, getComputedStyle);
+    try {
+      return computeTextAlternativeStep(current, context);
+    } finally {
+      inHiddenReferencedTraversal = outerTraversal;
+    }
+  }
+  function computeTextAlternativeStep(current, context) {
     if (consultedNodes.has(current)) {
       return "";
     }
 
     // 2A
-    if (!hidden && isHidden(current, getComputedStyle) && !context.isReferenced) {
+    if (!hidden && isHidden(current, getComputedStyle) && !context.isReferenced && !inHiddenReferencedTraversal) {
       consultedNodes.add(current);
       return "";
     }
