{
  "extends": "./../ts/tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2021", "DOM", "DOM.Iterable", "ESNext.Promise"],
    "noImplicitThis": false,
    "preserveWatchOutput": true,
    "sourceMap": true,
    "strictNullChecks": true,
    "noEmit": true,
    "outDir": "dist",
    "noErrorTruncation": true,
    "types": [],
    "resolveJsonModule": true,
    // Specs have no imports or exports, so without this their top-level
    // declarations would share one global scope. It stays out of
    // cypress/tsconfig.json, which compiles `Cypress.require` dependencies:
    // there it would emit dependencies.support-commonjs.ts as an ES module
    "moduleDetection": "force"
  },
  "exclude": [
    "dist"
  ]
}
