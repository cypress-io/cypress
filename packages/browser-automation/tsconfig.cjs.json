{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./lib",
    "outDir": "./cjs",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false
  },
  "include": [
    "lib/*.ts",
    "lib/**/*.ts"
  ],
  "exclude": [
    "test/**"
  ]
}
