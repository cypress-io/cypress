{
  "include": [
    "src"
  ],
  "exclude": [
    "src/gen"
  ],
  "compilerOptions": {
    "lib": [
      "esnext"
    ],
    "allowJs": false,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "cypress",
      "mocha",
      "node"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "useUnknownInCatchVariables": false
  }
}
