{
  "include": [
    "lib/*.ts",
    "lib/**/*.ts"
  ],
  "exclude": [
    "test"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ]
  }
}
