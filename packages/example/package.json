{
  "name": "@packages/example",
  "version": "0.0.0-development",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsx ./bin/build.ts && gulp build",
    "build-prod": "tsc -p tsconfig.prod.json",
    "check-ts": "tsc --noEmit",
    "clean-deps": "rimraf node_modules",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build -b gh-pages",
    "postinstall": "echo '@packages/example needs: yarn build'",
    "test": "yarn test-unit",
    "test-e2e": "cypress run",
    "test-unit": "vitest run"
  },
  "devDependencies": {
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "7.1.1",
    "cypress-example-kitchensink": "6.1.0",
    "fs-extra": "9.1.0",
    "gh-pages": "5.0.0",
    "glob": "7.1.6",
    "gulp": "4.0.2",
    "gulp-clean": "0.4.0",
    "gulp-rev-all": "2.0.2",
    "resolve-pkg": "2.0.0",
    "tsx": "^4.23.12",
    "vitest": "^3.2.4"
  },
  "files": [
    "cypress",
    "lib"
  ],
  "types": "index.d.ts",
  "license": "MIT",
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/cypress",
          "{projectRoot}/app",
          "{projectRoot}/build"
        ]
      }
    }
  }
}
