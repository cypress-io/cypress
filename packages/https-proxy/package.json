{
  "name": "@packages/https-proxy",
  "version": "0.0.0-development",
  "private": true,
  "license": "MIT",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "cjs/index.d.ts",
  "files": [
    "cjs/*",
    "esm/*"
  ],
  "scripts": {
    "build": "yarn build:esm && yarn build:cjs",
    "build:cjs": "rimraf cjs && tsc -p tsconfig.cjs.json",
    "build:esm": "rimraf esm && tsc -p tsconfig.esm.json",
    "build-prod": "yarn build",
    "check-ts": "tsc -p tsconfig.cjs.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.cjs.tsbuildinfo",
    "clean-deps": "rimraf node_modules",
    "lint": "eslint",
    "regenerate:certs": "cd ./test/helpers/certs && ./regenerate-certs.sh",
    "test": "yarn test-unit",
    "test-debug": "vitest --inspect-brk --test-timeout=0 --hook-timeout=0",
    "test-unit": "vitest run",
    "test-watch": "vitest --watch"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json}": "eslint --fix"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "fs-extra": "9.1.0",
    "lodash": "^4.17.21",
    "node-forge": "^1.4.0",
    "semaphore": "1.1.0"
  },
  "devDependencies": {
    "@cypress/debugging-proxy": "2.0.1",
    "@cypress/request": "^4.0.0",
    "@cypress/request-promise": "^5.0.0",
    "@packages/eslint-config": "0.0.0-development",
    "@packages/network": "0.0.0-development",
    "@types/semaphore": "1.1.4",
    "eslint": "^9.31.0",
    "jiti": "^2.4.2",
    "tsx": "^4.23.12",
    "vitest": "^3.2.4"
  },
  "nx": {}
}
