{
  "name": "@packages/root",
  "version": "0.0.0-development",
  "description": "dummy package pointing at the root package",
  "main": "index.js",
  "scripts": {
    "build": "yarn build:cjs && yarn build:esm",
    "build:cjs": "rollup -c rollup.config.mjs -f cjs -o index.js",
    "build:esm": "rollup -c rollup.config.mjs -f esm -o index.mjs",
    "build:prod": "yarn build"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "rollup": "^4.52.0",
    "typescript": "^5.6.3"
  },
  "module": "index.mjs",
  "nx": {}
}
