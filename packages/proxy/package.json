{
  "name": "@packages/proxy",
  "version": "0.0.0-development",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "types": "./lib/index.ts",
  "files": [
    "lib"
  ],
  "workspaces": {
    "nohoist": [
      "devtools-protocol"
    ]
  },
  "scripts": {
    "build-prod": "tsc --project .",
    "check-ts": "tsc --noEmit && yarn -s tslint",
    "clean": "rimraf --glob 'lib/**/*.js'",
    "clean-deps": "rimraf node_modules",
    "lint": "eslint",
    "test": "vitest run",
    "test-debug": "vitest --inspect-brk --no-file-parallelism --test-timeout=0",
    "test-watch": "vitest watch",
    "tslint": "tslint --config ../ts/tslint.json --project ."
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json}": "eslint --fix"
  },
  "dependencies": {
    "@packages/socket": "0.0.0-development",
    "bluebird": "3.5.3",
    "chalk": "2.4.2",
    "charset": "1.0.1",
    "common-tags": "1.8.0",
    "debug": "^4.3.4",
    "grapheme-splitter": "1.0.4",
    "iconv-lite": "0.6.2",
    "lodash": "^4.17.19",
    "pumpify": "1.5.1",
    "through": "2.3.8",
    "utf8-stream": "0.0.0"
  },
  "devDependencies": {
    "@cypress/request": "^4.0.0",
    "@cypress/request-promise": "^5.0.0",
    "@packages/errors": "0.0.0-development",
    "@packages/eslint-config": "0.0.0-development",
    "@packages/net-stubbing": "0.0.0-development",
    "@packages/network": "0.0.0-development",
    "@packages/network-interception": "0.0.0-development",
    "@packages/network-tools": "0.0.0-development",
    "@packages/resolve-dist": "0.0.0-development",
    "@packages/server": "0.0.0-development",
    "@packages/telemetry": "0.0.0-development",
    "@packages/types": "0.0.0-development",
    "@types/express": "4.17.2",
    "@types/supertest": "2.0.16",
    "devtools-protocol": "0.0.1687809",
    "eslint": "^9.31.0",
    "express": "4.21.0",
    "globals": "^15.12.0",
    "jiti": "^2.4.2",
    "supertest": "6.0.1",
    "typescript": "~5.4.5",
    "vitest": "^3.2.4"
  },
  "nx": {}
}
