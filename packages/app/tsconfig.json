{
  "extends": "../frontend-shared/tsconfig.json",
  // React `.tsx` files are checked by tsconfig.react.json
  "include": [
    "src/**/*.vue",
    "src/**/*.vue.tsx",
    "src/**/*.vue.cy.tsx",
    "src/**/*.vue.spec.tsx",
    "src/**/*.ts",
    "cypress/**/*.ts",
    "cypress/**/*.vue.tsx",
    "cypress/**/*.vue.cy.tsx",
    "cypress/**/*.vue.spec.tsx",
    "*.d.ts",
    "../frontend-shared/src/**/*.vue",
    "../frontend-shared/src/**/*.vue.tsx",
    "../frontend-shared/src/**/*.vue.cy.tsx",
    "../frontend-shared/src/**/*.vue.spec.tsx",
    "../frontend-shared/cypress/**/*.ts"
  ],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    // needed for mobx
    "useDefineForClassFields": true,
    "noImplicitThis": true,
    "paths": {
      "@cy/components/*": ["../frontend-shared/src/components/*"],
      "@cy/gql-components/*": ["../frontend-shared/src/gql-components/*"],
      "@cy/store/*": ["../frontend-shared/src/store/*"],
      "@packages/*": ["../*"],
      // see src/runner/react-untyped.d.ts
      "#host/*": ["./src/runner/react-untyped.d.ts"]
    },
    "target": "ES2022",
    "types": [
      "cypress", 
      "cypress-real-events", 
      "@intlify/unplugin-vue-i18n/messages",
      "@testing-library/cypress"
    ]
  }
}
